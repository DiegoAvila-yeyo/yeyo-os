# YeyoOS Environment Configuration
DATABASE_URL=postgresql://yeyo:YOUR_PASSWORD@127.0.0.1:5432/yeyo_db
TEST_DATABASE_URL=postgresql://yeyo:YOUR_PASSWORD@127.0.0.1:5432/yeyo_test_db

# Redis
REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:6379/0

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Ollama (YEYO-HACK / aislado)
# Segunda instancia (separada) para modelos 'uncensored' como dolphin-llama3.
# Recomendación: mantenerla OFF por defecto.
OLLAMA_HACK_ENABLED=false
OLLAMA_HACK_HOST=http://localhost:11435
OLLAMA_HACK_MODEL=dolphin-llama3

# Cloud Memory Sync (Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
